{
  "compilerOptions": {
    // Checking
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    // Resolution
    "moduleResolution": "node",
    "esModuleInterop": true,
    "baseUrl": "./",
    // Compilation
    "declaration": true,
    "removeComments": true,
    "target": "ES2019",
    "module": "commonjs",
    "outDir": "./lib/cjs"
  },
  "include": ["./src/**/*"],
  "exclude": ["./src/__tests__/**/*"]
}
