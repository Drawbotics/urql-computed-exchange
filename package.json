    "import-sort-style-module": "^6.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^9.5.0",
    "prettier": "^1.19.1",
    "prettier-plugin-import-sort": "0.0.3",
    "react": "^16.12.0",
    "rimraf": "^3.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "urql": "^5.0.1",
    "wonka": "^6.3.5"
