{
  "name": "@drawbotics/urql-computed-exchange",
  "version": "1.2.0",
  "description": "URQL exchange to allow computed properties in GraphQL queries.",
  "keywords": [],
  "license": "UNLICENSED",
  "main": "lib/index.js",
