    "urql": "^1.8.0 || ^2.0.0 || ^3.0.0 || ^4.0.0 || ^5.0.0",
    "wonka": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.15",
    "@types/react": "^16.9.18",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "eslint-plugin-jest": "^29.15.0",
    "graphql": "^16.13.1",
