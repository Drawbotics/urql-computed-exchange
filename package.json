    "build": "tsc",
    "build:watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration:watch": "jest --config ./jest.integration.config.js --watch",
    "prepublishOnly": "npm run clean && npm run build"
